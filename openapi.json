{
    "openapi": "3.0.3",
    "info": {
        "title": "Virgin Fund API",
        "version": "1.0.0",
        "description": "Expanded API for bots, marketplace, alerts, integrations and backtests."
    },
    "servers": [
        {
            "url": "http://localhost:3000",
            "description": "Local"
        }
    ],
    "components": {
        "securitySchemes": {
            "ServiceBearer": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        },
        "schemas": {
            "Bot": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "owner_id": {
                        "type": "string",
                        "nullable": true
                    },
                    "name": {
                        "type": "string"
                    },
                    "strategy": {
                        "type": "string"
                    },
                    "composite": {
                        "type": "boolean",
                        "description": "true if bot is composite (chains strategies)"
                    },
                    "assets": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "allocation": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "items": {
                            "type": "number"
                        }
                    },
                    "mode": {
                        "type": "string",
                        "enum": [
                            "paper",
                            "live"
                        ]
                    },
                    "template_id": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "metadata": {
                        "type": "object"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "Strategy": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "config": {
                        "type": "object"
                    }
                }
            },
            "MarketplaceListing": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "author_id": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "bot_template": {
                        "$ref": "#/components/schemas/Bot"
                    },
                    "price_usd": {
                        "type": [
                            "number",
                            "null"
                        ]
                    },
                    "anonymized_performance": {
                        "type": "object"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "CompositeBot": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "chain": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "Alert": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "owner_id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "enabled": {
                        "type": "boolean"
                    },
                    "conditions": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/AlertCondition"
                        }
                    },
                    "delivery": {
                        "type": "object",
                        "properties": {
                            "email": {
                                "type": "boolean"
                            },
                            "webhook": {
                                "type": "boolean"
                            },
                            "in_app": {
                                "type": "boolean"
                            }
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "AlertCondition": {
                "type": "object",
                "properties": {
                    "metric": {
                        "type": "string",
                        "example": "price"
                    },
                    "operator": {
                        "type": "string",
                        "enum": [
                            ">",
                            "<",
                            ">=",
                            "<=",
                            "==",
                            "AND",
                            "OR"
                        ]
                    },
                    "value": {
                        "type": [
                            "number",
                            "string",
                            "object"
                        ]
                    },
                    "window": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            },
            "Watchlist": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "owner_id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "symbols": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "BacktestRequest": {
                "type": "object",
                "properties": {
                    "symbol": {
                        "type": "string"
                    },
                    "start": {
                        "type": "string"
                    },
                    "end": {
                        "type": "string"
                    },
                    "initialCapital": {
                        "type": "number"
                    }
                }
            },
            "BacktestResult": {
                "type": "object"
            },
            "BacktestRecord": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "results": {
                        "type": "object"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "OrderRecord": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "bot_id": {
                        "type": "string"
                    },
                    "side": {
                        "type": "string"
                    },
                    "qty": {
                        "type": "number"
                    },
                    "price": {
                        "type": "number"
                    },
                    "status": {
                        "type": "string"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "BrokerAccount": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "provider": {
                        "type": "string"
                    },
                    "display_name": {
                        "type": "string"
                    }
                }
            },
            "WebhookSubscription": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string"
                    },
                    "events": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "SubscriptionPlan": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "monthly_usd": {
                        "type": "number"
                    }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "security": [
        {
            "ServiceBearer": []
        }
    ],
        "paths": {
            "/api/marketplace": {
                "get": {
                    "summary": "List marketplace listings",
                    "responses": {
                        "200": {
                            "description": "OK",
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "type": "array",
                                        "items": { "$ref": "#/components/schemas/MarketplaceListing" }
                                    }
                                }
                            }
                        }
                    }
                },
                "post": {
                    "summary": "Publish a listing",
                    "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MarketplaceListing" } } } },
                    "responses": { "201": { "description": "Created" } }
                }
            },
            "/api/marketplace/{id}/copy": {
                "post": {
                    "summary": "Copy a listing into user's templates",
                    "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
                    "responses": { "201": { "description": "Copied", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bot" } } } } }
                }
            },
            "/api/bots/{id}/clone": {
                "post": { "summary": "Clone a bot", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "201": { "description": "Cloned", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bot" } } } } }
            },
            "/api/bots/{id}/mode": {
                "post": { "summary": "Switch bot mode (paper/live)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "mode": { "type": "string", "enum": ["paper", "live"] } } } } } }, "responses": { "200": { "description": "Mode updated" } } }
            },
            "/api/rebalancer/run": { "post": { "summary": "Run auto-rebalancer across bots/portfolio", "responses": { "200": { "description": "Rebalance executed" } } } },
            "/api/alerts": { "get": { "summary": "List alerts", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Alert" } } } } } }, "post": { "summary": "Create alert", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Alert" } } } }, "responses": { "201": { "description": "Created" } } } },
            "/api/alerts/{id}/trigger": { "post": { "summary": "Trigger an alert manually (for testing)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Triggered" } } } },
            "/api/feed/news": { "get": { "summary": "News & sentiment feed filtered by watchlist symbols", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object" } } } } } } },
            "/api/integrations/brokers": { "get": { "summary": "List connected broker accounts", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/BrokerAccount" } } } } } }, "post": { "summary": "Connect a new broker account (OAuth/API keys)", "requestBody": { "required": true }, "responses": { "201": { "description": "Connected" } } } },
            "/api/webhooks": { "get": { "summary": "List webhooks", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/WebhookSubscription" } } } } } }, "post": { "summary": "Register webhook", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookSubscription" } } } }, "responses": { "201": { "description": "Registered" } } } },
            "/api/subscriptions": { "get": { "summary": "List subscription plans", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/SubscriptionPlan" } } } } } } },
            "/api/portfolio/export": { "post": { "summary": "Export portfolio/trades CSV or push to Google Sheets", "responses": { "200": { "description": "Export job created" } } } }
        }
    }
}}}}}}
