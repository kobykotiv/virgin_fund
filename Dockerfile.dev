# =============================================================================
# Virgin Fund - Development Dockerfile
# Multi-stage build for development environment
# =============================================================================

# ================================
# Base Stage
# ================================
FROM node:20-alpine AS base
LABEL maintainer="Virgin Fund Team"
LABEL description="Virgin Fund Platform - Development"

# Install system dependencies
RUN apk add --no-cache \
    libc6-compat \
    curl \
    git \
    && rm -rf /var/cache/apk/*

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY pnpm-lock.yaml ./

# ================================
# Dependencies Stage
# ================================
FROM base AS deps
RUN npm install -g pnpm@8

# Install dependencies
RUN pnpm install --frozen-lockfile

# ================================
# Development Stage
# ================================
FROM deps AS development

# Copy source code
COPY . .

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Set permissions
RUN chown -R nextjs:nodejs /app
USER nextjs

# Expose ports
EXPOSE 3000 9229

# Default command
CMD ["pnpm", "run", "dev"]
