{
  "name": "virgin-fund",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.4",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "clean": "rimraf .next out",
    "prebuild": "npm run clean",
    "format": "prettier --write .",
    "lint": "next lint",
    "typecheck": "bun tsc --noEmit",
    "install:bun": "bun install",
    "test": "vitest --config vitest.config.cjs",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:components": "vitest --include \"__tests__/components/**/*.test.{ts,tsx}\" --environment jsdom --threads=false",
    "test:unit": "vitest --include \"__tests__/lib/**/*.test.{ts,tsx}\"",
    "seed:dev": "node ./scripts/dev-seed.mjs",
    "e2e": "playwright test",
    "gen:openapi:types": "node ./scripts/gen-openapi-types.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.55.0",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-query-devtools": "^5.85.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.542.0",
    "next": "15.2.4",
    "openai": "^4.8.0",
    "react": "^19.1.0",
    "react-awesome-reveal": "^4.3.1",
    "react-awesome-shapes": "^0.1.12",
    "react-chartjs-2": "^5.3.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.55.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^3.1.2",
    "sonner": "^1.7.4",
    "swr": "^2.3.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "vaul": "^0.9.9",
    "yahoo-finance2": "^2.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.35.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "cron-parser": "^4.9.0",
    "openapi-typescript": "^6.7.0",
    "prettier": "^3.0.0",
    "rimraf": "^4.4.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
