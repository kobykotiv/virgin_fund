# Alpaca API Configuration
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
ALPACA_API_PAPER=true
ALPACA_API_BASE_URL="https://paper-api.alpaca.markets"

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/virgin_fund"
DATABASE_SSL_ENABLED=false

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-32-character-secret-key"
JWT_SECRET="your-jwt-secret-key"

# Security
NEXT_PUBLIC_CREDENTIAL_ENCRYPTION_KEY="32-character-key-for-credential-encrypt"

# Feature Flags
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_ENABLE_PAPER_TRADING=true
NEXT_PUBLIC_ENABLE_LIVE_TRADING=false

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_MS=60000

# Monitoring
SENTRY_DSN=""
NEXT_PUBLIC_ANALYTICS_ID=""

# Cache Configuration
REDIS_URL=""
CACHE_TTL_SECONDS=300

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-32-char-secret-here"

# CAPTCHA Configuration
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""
HCAPTCHA_SECRET_KEY=""

# Encryption (for Alpaca credentials)
ENCRYPTION_KEY="generate-a-32-byte-encryption-key"

# Feature Flags
ENABLE_DEMO_MODE="false"
ENABLE_PAPER_TRADING="true"
ENABLE_LIVE_TRADING="false"
